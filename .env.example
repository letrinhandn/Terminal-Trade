# Local secrets only (.env.local). Never commit real keys.

# Finnhub - equity profile extras (optional)
# https://finnhub.io/
FINNHUB_API_KEY=

# FRED - economy / macro series (optional but required for ECONOMY tab)
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# CoinGecko Demo - crypto market cap / quotes for prototype (non-commercial)
# https://www.coingecko.com/en/api/pricing
# Create a Demo key in the developer portal (~10k credits/month).
COINGECKO_DEMO_API_KEY=
# Alias accepted by the same client:
# COINGECKO_API_KEY=

# CoinDesk Data API - OPTIONAL / DEFERRED (paid only since 2026-05-21)
# Free Personal access ended; accounts without a subscription cannot call the API.
# Contact CoinDesk Data Sales for pricing + display/redistribution rights before
# using for customer-facing Terminal Trade. Prefer CoinGecko + Coinbase for free builds.
# https://data.coindesk.com/
COINDESK_API_KEY=

# Yahoo Finance + Deribit + Coinbase Exchange public candles + RSS need no keys
# CoinDesk news headlines use the public RSS feed (not the Data API).
