# API Keys Configuration Template
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to GitHub (it's in .gitignore)

# ========================================
# REQUIRED FOR OPTIONS MODULE
# ========================================

# ========================================
# MARKET DATA APIS
# ========================================

# Finnhub (https://finnhub.io/)
# Used for: Stock fundamentals, earnings, news
FINNHUB_API_KEY=your_finnhub_api_key_here
FINNHUB_ENABLED=false


# ========================================
# DATA MANAGEMENT
# ========================================

# Yahoo Finance (no key needed)
YAHOO_FINANCE_ENABLED=true

# Data Cache Settings
DATA_CACHE_ENABLED=true
DATA_CACHE_DIR=cache/

# ========================================
# SETUP INSTRUCTIONS
# ========================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API keys (get from provider websites)
# 3. Set _ENABLED=true for APIs you want to use
# 4. Never commit .env to version control
# 5. Restart application after changes
